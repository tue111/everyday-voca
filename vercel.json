{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/speech.ts": {
      "maxDuration": 60
    },
    "api/cron.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=generate",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?job=morning",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron?job=evening",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw.js|manifest.webmanifest|icon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
