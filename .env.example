# Local default uses .data/state.json and fake providers. Never commit .env.
APP_MODE=local
APP_URL=http://127.0.0.1:5173
# Production requires MongoDB, HTTPS APP_URL, and CRON_SECRET (32+ random characters).
MONGODB_URI=
MONGODB_DATABASE=everyday_voca
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MONTHLY_BUDGET_USD=3
# Conservative speech usage allowance; actual billing also needs provider monitoring.
TTS_MONTHLY_BUDGET_USD=1
AI_INPUT_USD_PER_MILLION=0.1
AI_OUTPUT_USD_PER_MILLION=0.5
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
